{
  "name": "skill-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "独立、只读的本地技能阅读器",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server/start.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/server/*.test.mjs tests/web/*.test.mjs",
    "test:server": "node --test tests/server/*.test.mjs",
    "test:web": "node --test tests/web/*.test.mjs",
    "test:e2e": "node tests/e2e/reader.mjs",
    "check": "node scripts/check.mjs",
    "baseline": "node scripts/source-baseline.mjs check",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1"
  }
}
